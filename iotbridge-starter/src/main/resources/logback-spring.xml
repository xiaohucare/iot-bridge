<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置：控制台 + 滚动文件。

  模板包含链路字段，便于把「REST 请求 -> Rabbit 消费 -> 设备写入」串起来：
    traceId     REST 请求标识（TraceIdFilter 写入）
    deviceId    当前处理的设备
    protocolType 当前处理的协议
    requestId   下行指令请求号
  未设置的字段以空 [] 呈现，grep 时可精确匹配 traceId/deviceId。

  文件输出路径可用环境变量 LOG_PATH 覆盖（默认 ./logs）。
-->
<configuration>

    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-}][%X{deviceId:-}][%X{requestId:-}] %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/iotbridge.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/iotbridge.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 单文件上限 / 保留天数 / 总量上限，防止磁盘被日志吃满 -->
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="com.iotbridge" level="INFO"/>
    <!-- 第三方框架噪音抑制：Netty/MQ 客户端就绪期日志较多 -->
    <logger name="io.netty" level="INFO"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.springframework.amqp" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
