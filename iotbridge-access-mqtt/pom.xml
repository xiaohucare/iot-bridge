            <artifactId>iotbridge-spi</artifactId>
        </dependency>
        <!-- 复用通用会话管理（ChannelManager）与上行帧事件模型，保持 TCP/MQTT 会话寻址一致 -->
        <dependency>
            <groupId>com.iotbridge</groupId>
            <artifactId>iotbridge-access-netty</artifactId>
        </dependency>

        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
